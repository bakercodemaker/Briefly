# Ignore git metadata and local-only files in the development image context.
/.git/
/.gitignore
/.bundle
/.env*

# Ignore local secrets.
/config/master.key
/config/credentials/*.key

# Ignore generated or host-local runtime data.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep
/storage/*
!/storage/.keep
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets
