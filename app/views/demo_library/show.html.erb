<main class="mx-auto min-h-screen max-w-6xl px-6 py-16 sm:px-10">
  <%= link_to "Briefly", root_path, class: "text-sm font-semibold uppercase tracking-[0.2em] text-emerald-700" %>
  <p class="mt-12 text-sm font-semibold uppercase tracking-[0.2em] text-emerald-700">Demo Library</p>
  <h1 class="mt-4 max-w-3xl text-5xl font-semibold tracking-tight text-slate-950">A public window into the finished reading experience.</h1>
  <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">These curated Briefs are generated from public YouTube sources. This public area never accepts a source URL or exposes private reading history.</p>

  <section class="mt-12" aria-labelledby="demo-briefs-heading">
    <h2 id="demo-briefs-heading" class="text-xl font-semibold text-slate-950">Curated Briefs</h2>
    <ul class="mt-5 grid gap-4 sm:grid-cols-2">
      <% @briefs.each do |brief| %>
        <li>
          <%= link_to demo_brief_path(brief), class: "block h-full rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-emerald-500" do %>
            <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700">Generated Brief</p>
            <h3 class="mt-3 text-lg font-semibold text-slate-950"><%= brief.source_title %></h3>
            <p class="mt-2 text-sm text-slate-600"><%= brief.source_channel %> · <%= brief.published_on %> · <%= brief.duration_seconds / 60 %> min</p>
            <p class="mt-4 line-clamp-2 text-sm leading-6 text-slate-600"><%= brief.key_conclusions.first %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
</main>
