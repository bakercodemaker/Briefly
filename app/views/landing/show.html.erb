<main class="mx-auto flex min-h-screen max-w-6xl flex-col justify-center px-6 py-16 sm:px-10">
  <p class="text-sm font-semibold uppercase tracking-[0.2em] text-emerald-700">Briefly</p>
  <h1 class="mt-6 max-w-3xl text-5xl font-semibold tracking-tight text-slate-950 sm:text-7xl">A better way to catch up.</h1>
  <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">A private workspace for turning selected public YouTube videos into detailed, source-faithful Briefs.</p>
  <div class="mt-10 flex flex-wrap gap-4">
    <%= link_to "Unlock Personal Workspace", access_path, class: "rounded-full bg-slate-950 px-5 py-3 font-semibold text-white" %>
    <%= link_to "Explore the Demo Library", demo_path, class: "rounded-full border border-slate-300 px-5 py-3 font-semibold text-slate-800" %>
  </div>
</main>
