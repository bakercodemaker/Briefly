<article class="mt-12 border-t border-slate-200 pt-10">
  <h1 class="text-4xl font-semibold tracking-tight text-slate-950"><%= brief.source_title %></h1>
  <p class="mt-3 text-slate-600"><%= brief.source_channel %> · <%= brief.published_on %> · <%= brief.duration_seconds / 60 %> min</p>
  <a href="<%= brief.source_url %>" class="mt-3 inline-block text-sm text-emerald-700 underline">Watch the original YouTube video</a>
  <% if local_assigns.fetch(:show_archive, true) %>
    <%= button_to "Archive Brief", archive_brief_path(brief), method: :patch, class: "mt-3 block text-sm font-semibold text-rose-700 underline", form: { data: { turbo_confirm: "Archive this Brief? Its Analysis Request will be removed from active history, and the Brief will remain available in Archived Briefs." } } %>
  <% end %>

  <section class="mt-10">
    <h2 class="text-xl font-semibold text-slate-950">Key conclusions</h2>
    <ul class="mt-4 list-disc space-y-2 pl-5 text-slate-700">
      <% brief.key_conclusions.each do |conclusion| %>
        <li><%= conclusion %></li>
      <% end %>
    </ul>
  </section>

  <% brief.structured_content.fetch("sections").each do |section| %>
    <section class="mt-10">
      <h2 class="text-xl font-semibold text-slate-950"><%= section.fetch("heading") %></h2>
      <p class="mt-3 whitespace-pre-line leading-7 text-slate-700"><%= section.fetch("body") %></p>
    </section>
  <% end %>

  <p class="mt-12 border-t border-slate-200 pt-6 text-sm text-slate-500">This Brief was generated from the linked source, may contain errors, and is not verified advice.</p>
</article>
