<main class="mx-auto min-h-screen max-w-6xl px-6 py-16 sm:px-10">
  <%= link_to "← Personal Workspace", workspace_path, class: "text-sm font-semibold text-emerald-700 underline" %>
  <h1 class="mt-6 text-4xl font-semibold tracking-tight text-slate-950">Archived Briefs</h1>
  <p class="mt-3 max-w-xl text-slate-600">Archived Briefs are kept here and removed from your active library.</p>

  <% if @briefs.any? %>
    <ul class="mt-8 grid gap-3 sm:grid-cols-2">
      <% @briefs.each do |brief| %>
        <li>
          <%= link_to brief_path(brief), class: "block rounded-2xl border border-slate-200 bg-white p-4 transition hover:border-emerald-500" do %>
            <p class="text-base font-semibold text-slate-950"><%= brief.source_title %></p>
            <p class="mt-2 text-sm text-slate-600"><%= brief.source_channel %> · <%= brief.published_on %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-8 text-slate-600">No archived Briefs yet.</p>
  <% end %>
</main>
