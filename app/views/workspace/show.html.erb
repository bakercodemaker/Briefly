<main class="mx-auto flex min-h-screen max-w-6xl flex-col justify-center px-6 py-16 sm:px-10">
  <div class="flex items-center justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-emerald-700">Briefly / Personal Workspace</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-950">Read with focus.</h1>
    </div>
    <%= button_to "Lock workspace", access_path, method: :delete, class: "rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-800" %>
  </div>
  <section class="mt-10 rounded-3xl bg-slate-950 p-8 text-white">
    <h2 class="text-2xl font-semibold">Your next Brief starts with a source.</h2>
    <p class="mt-3 max-w-xl text-slate-300">Paste one public YouTube video URL. We will queue it for a Polish-language Brief.</p>

    <%= form_with model: @analysis_request, class: "mt-6 flex flex-col gap-3 sm:flex-row" do |form| %>
      <%= form.url_field :source_url, placeholder: "https://www.youtube.com/watch?v=…", required: true, class: "min-w-0 flex-1 rounded-xl border border-slate-600 bg-slate-900 px-4 py-3 text-white placeholder:text-slate-400", aria: { describedby: "source-url-help" } %>
      <%= form.submit "Queue analysis", class: "rounded-xl bg-emerald-400 px-5 py-3 font-semibold text-slate-950" %>
    <% end %>
    <p id="source-url-help" class="mt-3 text-sm text-slate-400">Only public YouTube video URLs are supported.</p>
    <% if @analysis_request.errors[:source_url].any? %>
      <p class="mt-3 text-sm font-medium text-rose-300"><%= @analysis_request.errors[:source_url].first %></p>
    <% end %>
    <% if @analysis_request.errors[:base].any? %>
      <p class="mt-3 text-sm font-medium text-rose-300"><%= @analysis_request.errors[:base].first %></p>
    <% end %>
  </section>

  <% if @analysis_request_count.positive? %>
    <section class="mt-8">
      <h2 class="text-xl font-semibold text-slate-950">Analysis Requests</h2>
      <ul class="mt-4 space-y-3">
        <% @display_analysis_requests.each do |analysis_request| %>
          <li class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200 bg-white px-5 py-4">
            <a href="<%= analysis_request.source_url %>" class="min-w-0 truncate text-sm text-slate-700 underline"><%= analysis_request.display_title %></a>
            <div class="flex shrink-0 items-center gap-3">
              <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-amber-800"><%= analysis_request.lifecycle_state %></span>
              <% if analysis_request.brief %>
                <%= link_to "Open Brief", workspace_path(brief_id: analysis_request.brief), class: "text-sm font-semibold text-emerald-700 underline" %>
              <% end %>
              <% if analysis_request.recoverable_failure? %>
                <%= button_to "Retry", retry_analysis_request_path(analysis_request), class: "text-sm font-semibold text-emerald-700 underline" %>
              <% end %>
              <%= button_to "Archive", archive_analysis_request_path(analysis_request), method: :patch, class: "text-sm font-semibold text-rose-700 underline", form: { data: { turbo_confirm: "Archive this Analysis Request? Its Brief will be moved to Archived Briefs. Any queued or processing analysis will be cancelled." } } %>
            </div>
            <% if analysis_request.failure_message.present? %>
              <p class="basis-full text-sm text-rose-700"><%= analysis_request.failure_message %></p>
            <% end %>
            <% if analysis_request.failed? && !analysis_request.recoverable_failure? %>
              <p class="basis-full text-sm text-rose-700">This source failure is terminal and cannot be retried.</p>
            <% end %>
          </li>
        <% end %>
      </ul>
      <% if !@analysis_requests_expanded && @analysis_request_count > 3 %>
        <%= link_to "Show #{[ @analysis_request_count - 3, 7 ].min} more", workspace_path(show_all_requests: 1), class: "mt-4 inline-block text-sm font-semibold text-emerald-700 underline" %>
      <% elsif @analysis_requests_expanded && @analysis_requests_total_pages > 1 %>
        <nav class="mt-4 flex items-center gap-3" aria-label="Analysis Request pagination">
          <% if @analysis_requests_page > 1 %>
            <%= link_to "Newer", workspace_path(show_all_requests: 1, requests_page: @analysis_requests_page - 1), class: "text-sm font-semibold text-emerald-700 underline" %>
          <% end %>
          <span class="text-sm text-slate-600">Page <%= @analysis_requests_page %> of <%= @analysis_requests_total_pages %></span>
          <% if @analysis_requests_page < @analysis_requests_total_pages %>
            <%= link_to "Older", workspace_path(show_all_requests: 1, requests_page: @analysis_requests_page + 1), class: "text-sm font-semibold text-emerald-700 underline" %>
          <% end %>
        </nav>
      <% end %>
    </section>
  <% end %>

  <% if @briefs_by_channel.any? %>
    <section class="mt-8" aria-labelledby="brief-library-heading">
      <h2 id="brief-library-heading" class="text-xl font-semibold text-slate-950">Personal Brief Library</h2>
      <div class="mt-4 space-y-6">
        <% @briefs_by_channel.each do |channel, briefs| %>
          <section aria-labelledby="channel-<%= channel.parameterize %>">
            <h3 id="channel-<%= channel.parameterize %>" class="text-sm font-semibold uppercase tracking-wide text-slate-600"><%= channel %></h3>
            <ul class="mt-3 grid gap-3 sm:grid-cols-2">
              <% briefs.each do |brief| %>
                <li>
                  <%= link_to workspace_path(brief_id: brief), class: "block rounded-2xl border border-slate-200 bg-white p-4 transition hover:border-emerald-500" do %>
                    <p class="text-base font-semibold text-slate-950"><%= brief.source_title %></p>
                    <p class="mt-2 text-sm text-slate-600"><%= brief.published_on %> · <%= brief.duration_seconds / 60 %> min · <%= brief.output_language.upcase %></p>
                    <p class="mt-3 line-clamp-2 text-sm text-slate-600"><%= brief.key_conclusions.first %></p>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @archived_brief_count.positive? %>
    <%= link_to "Archived Briefs", archived_briefs_path, class: "mt-5 inline-block text-sm font-semibold text-emerald-700 underline" %>
  <% end %>

  <% if @open_brief %>
    <%= render "briefs/brief", brief: @open_brief, show_archive: !@open_brief.analysis_request.archived? %>
  <% end %>
</main>
